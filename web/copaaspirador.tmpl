            box-shadow: 0 0 0 4px #00d9ff, 0 0 22px 6px #00a2ffaa;
            position: relative; animation: roll 1.6s linear infinite;
        }
        #caloader .robot::after {
            content: ""; position: absolute; width: 12px; height: 12px; border-radius: 50%;
            background: #fff; top: 12px; right: 12px; box-shadow: 0 0 8px #fff;
        }
        @keyframes roll { 0% { transform: translateX(-120px) rotate(0deg); }
                          50% { transform: translateX(120px) rotate(360deg); }
                          100% { transform: translateX(-120px) rotate(720deg); } }
        #caloader .bar {
