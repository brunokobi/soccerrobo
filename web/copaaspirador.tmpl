    <script>
    (function () {
        var tips = ["Varrendo o campo...", "Calibrando os aspiradores...", "Enchendo a bola...",
                    "Acordando a torcida...", "Trocando a fita crepe do Zé Poeira...",
                    "Ligando os refletores...", "Aquecendo as escovas...", "Polindo o troféu..."];
        var i = 0, el = document.getElementById("loadtip");
        var t = setInterval(function () {
            var ld = document.getElementById("caloader");
            if (!ld || ld.classList.contains("ready") || ld.classList.contains("done")) { clearInterval(t); return; }
            i = (i + 1) % tips.length; el.textContent = tips[i];
        }, 1600);
    })();
    </script>

